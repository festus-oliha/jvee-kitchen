# Copy this file to .env and fill in the two values from
# Supabase: Project Settings > API (or "Connect" > App Frameworks).
# Both are safe to use in the website. Never put the service_role key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Email alerts (milestone 4) are set in Netlify, not here:
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY, ORDER_EMAIL_TO
# See the README section "Email alerts for new orders". Never put the service_role key in this file.
